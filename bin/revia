#!/bin/sh
set -eu

SOURCE=$0
case "$SOURCE" in
  */*) ;;
  *)
    SOURCE=$(command -v "$SOURCE" 2>/dev/null || true)
    ;;
esac

if [ -z "$SOURCE" ]; then
  printf '%s\n' 'Revia launcher path is unavailable.' >&2
  exit 70
fi

while [ -h "$SOURCE" ]; do
  SOURCE_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE")" && pwd)
  LINK=$(readlink "$SOURCE") || {
    printf '%s\n' 'Revia launcher symlink cannot be resolved.' >&2
    exit 70
  }
  case "$LINK" in
    /*) SOURCE=$LINK ;;
    *) SOURCE=$SOURCE_DIR/$LINK ;;
  esac
done

ROOT=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE")/.." && pwd)
VERSION=$(sed -n '1p' "$ROOT/VERSION")
REPOSITORY=${REVIA_REPOSITORY:-regrevia/Revia}
CACHE_ROOT=${XDG_CACHE_HOME:-"$HOME/.cache"}/revia
RELEASE_BASE_URL=${REVIA_RELEASE_BASE_URL:-"https://github.com/$REPOSITORY/releases/download/v$VERSION"}

usage() {
  if [ "$VERSION" = '1.0.0-rc.1' ]; then
    cat <<'EOF'
Usage: revia <command> [arguments]

Revia 1.0.0-rc.1 is an evaluation candidate. Native execution is measured
only on macOS arm64; all other targets are explicitly pending (exit 69).

Commands include check, manifest, execute, project-init, project-check,
project-test, project-multi-module-gate, and project-server-gate.

For the bounded, reproducible trials, see experiments/rc1/kit/README.md.
EOF
    return
  fi

  cat <<'EOF'
Revia native release CLI (versioned executable)
Usage: revia <native-command> [arguments]

Native source commands:
  check <file.re>
  lex <file.re>
  digest <file.re>
  canonical <file.re>
  manifest <file.re>
  translate <file.re>
  compile <source.re> <artifact>
  execute <source.re> <input-digest>
  run <graph> <artifact> <input-digest>
  project-check <project-dir>
  project-run <project-dir> <cache> <build> <profile> <toolchain> <module> <input-digest>
  project-translate <project> <cache> <build> <profile-digest> <toolchain-digest> <module>
  [Additional versioned runtime, project, and evidence commands]

This launcher invokes the versioned native executable. It does not invoke Node.
The Node reference CLI has a separate source-oriented surface:
  npm run re -- <command> [arguments]
  npm run re -- run <file.re> [-- <program-args>...]
    [--format json --runtime-receipt | --format json --authority-pin <pin.json>]
  Exactly one program argument collides with native run arity; use the explicit npm command.
  npm run re -- view [--locale zh-CN|en-US] [--format html|svg] <file.re>
  view, audit, profile, patch, review-index, build, project-projection,
  module-surface, project-translate

Use "revia help <command>" for both signatures where they overlap.
EOF
}

command_usage() {
  case "$1" in
    check) cat <<'EOF'
Native: revia check <file.re>
Reference: npm run re -- check [--format json | --write] <file.re>
EOF
      ;;
    run) cat <<'EOF'
Native: revia run <graph> <artifact> <input-digest>
Reference: npm run re -- run [--format json|text] <file.re> [-- <args>...]
          [--format json --runtime-receipt | --format json --authority-pin <pin.json>]
EOF
      ;;
    manifest) printf '%s\n' 'Native/reference: revia manifest <file.re> / npm run re -- manifest <file.re>' ;;
    translate) cat <<'EOF'
Native: revia translate <file.re>
Reference: npm run re -- translate --format json <file.re>
EOF
      ;;
    view) printf '%s\n' 'Node reference only: npm run re -- view [--locale zh-CN|en-US] [--format html|svg] <file.re>' ;;
    audit) printf '%s\n' 'Node reference only: npm run re -- audit --format json <file.re>' ;;
    profile) printf '%s\n' 'Node reference only: npm run re -- profile <file.re>' ;;
    patch) printf '%s\n' 'Node reference only: npm run re -- patch --patch <patch.json> <file.re>' ;;
    review-index) printf '%s\n' 'Node reference only: npm run re -- review-index [options] <file.re>' ;;
    build) printf '%s\n' 'Node reference only: npm run re -- build --out <dir> <file.re>' ;;
    project-check) cat <<'EOF'
Native: revia project-check <project-dir>
Reference: npm run re -- project-check --format json <project-dir>
EOF
      ;;
    project-run) cat <<'EOF'
Native: revia project-run <project> <cache> <build> <profile> <toolchain> <module> <input-digest>
Reference: npm run re -- project-run --fixture <fixture.json> <project-dir>
EOF
      ;;
    project-translate) cat <<'EOF'
Native: revia project-translate <project> <cache> <build> <profile-digest> <toolchain-digest> <module>
Reference: npm run re -- project-translate [--locale zh-CN|en-US] [--format json|text|html|svg] <project-dir>
EOF
      ;;
    project-projection) printf '%s\n' 'Node reference only: npm run re -- project-projection --routes <routes.json> --out <dir> <project-dir>' ;;
    module-surface) printf '%s\n' 'Node reference only: npm run re -- module-surface --manifest <manifest.json> <file.re>' ;;
    *)
      printf '%s\n' "Unknown Revia command: $1" >&2
      exit 64
      ;;
  esac
}

has_launcher_command_usage() {
  case "$1" in
    check|run|manifest|translate|view|audit|profile|patch|review-index|build|project-check|project-run|project-translate|project-projection|module-surface)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_source_file() {
  case "$1" in
    *.[rR][eE]) return 0 ;;
    *) return 1 ;;
  esac
}

is_reference_run_form() {
  # Three operands collide with the native run signature; native wins.
  [ "$#" -eq 3 ] && return 1

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --format)
        [ "$#" -ge 2 ] || return 1
        case "$2" in json|text) ;; *) return 1 ;; esac
        shift 2
        ;;
      --runtime-receipt)
        shift
        ;;
      --authority-pin)
        [ "$#" -ge 2 ] || return 1
        shift 2
        ;;
      *) break ;;
    esac
  done

  [ "$#" -ge 1 ] || return 1
  is_source_file "$1" || return 1
  shift
  [ "$#" -eq 0 ] && return 0
  [ "$1" = '--' ] && [ "$#" -ge 3 ]
}

source_form_diagnostic() {
  command=$1
  printf 'Revia native release CLI %s does not accept this source-form invocation.\n' "$VERSION" >&2
  case "$command" in
    run) printf '%s\n' 'Use the Node reference CLI: npm run re -- run <file.re> [-- <program-args>...]' >&2 ;;
    view|audit|profile|patch|review-index|build|project-projection|module-surface)
      command_usage "$command" >&2
      ;;
    project-check|project-run|project-translate|check|translate)
      command_usage "$command" >&2
      ;;
    *) printf '%s\n' 'Use the Node reference CLI: npm run re -- <command> [arguments]' >&2 ;;
  esac
  exit 64
}

check_source_form_invocation() {
  [ "$VERSION" = '1.0.0-rc.2.2.1' ] || return 0
  command=${1:-}
  [ "$#" -gt 0 ] && shift

  case "$command" in
    view|audit|profile|patch|review-index|build|project-projection|module-surface)
      source_form_diagnostic "$command"
      ;;
    run)
      if is_reference_run_form "$@"; then
        source_form_diagnostic "$command"
      fi
      ;;
    check)
      if [ "${1:-}" = '--write' ] && [ "$#" -eq 2 ] && is_source_file "$2"; then
        source_form_diagnostic "$command"
      fi
      if [ "${1:-}" = '--format' ] && [ "$#" -eq 3 ] && [ "$2" = 'json' ] && is_source_file "$3"; then
        source_form_diagnostic "$command"
      fi
      ;;
    translate)
      if [ "${1:-}" = '--format' ] && [ "$#" -eq 3 ] && [ "$2" = 'json' ] && is_source_file "$3"; then
        source_form_diagnostic "$command"
      fi
      ;;
    project-check)
      if [ "$#" -eq 3 ] && [ "$1" = '--format' ] && [ "$2" = 'json' ]; then
        source_form_diagnostic "$command"
      fi
      ;;
    project-run)
      if [ "$#" -eq 3 ] && [ "$1" = '--fixture' ]; then
        source_form_diagnostic "$command"
      fi
      ;;
    project-translate)
      case "${1:-}" in
        --locale)
          if { [ "$#" -eq 3 ] && { [ "$2" = 'zh-CN' ] || [ "$2" = 'en-US' ]; }; } \
            || { [ "$#" -eq 5 ] && { [ "$2" = 'zh-CN' ] || [ "$2" = 'en-US' ]; } \
              && [ "$3" = '--format' ] \
              && { [ "$4" = 'json' ] || [ "$4" = 'text' ] || [ "$4" = 'html' ] || [ "$4" = 'svg' ]; }; }; then
            source_form_diagnostic "$command"
          fi
          ;;
        --format)
          if { [ "$#" -eq 3 ] && { [ "$2" = 'json' ] || [ "$2" = 'text' ] || [ "$2" = 'html' ] || [ "$2" = 'svg' ]; }; } \
            || { [ "$#" -eq 5 ] \
              && { [ "$2" = 'json' ] || [ "$2" = 'text' ] || [ "$2" = 'html' ] || [ "$2" = 'svg' ]; } \
              && [ "$3" = '--locale' ] \
              && { [ "$4" = 'zh-CN' ] || [ "$4" = 'en-US' ]; }; }; then
            source_form_diagnostic "$command"
          fi
          ;;
        *)
          if [ "$#" -eq 1 ]; then source_form_diagnostic "$command"; fi
          ;;
      esac
      ;;
  esac
  return 0
}

case "${1:-}" in
  --version|version)
    if [ "$#" -eq 1 ]; then
      printf 'revia %s\n' "$VERSION"
      exit 0
    fi
    ;;
  --help)
    if [ "$#" -eq 1 ]; then
      usage
      exit 0
    fi
    ;;
  help)
    if [ "$#" -eq 1 ]; then
      usage
      exit 0
    elif [ "$#" -eq 2 ] && has_launcher_command_usage "$2"; then
      command_usage "$2"
      exit 0
    elif [ "$#" -gt 2 ]; then
      printf '%s\n' 'Usage: revia help <command>' >&2
      exit 64
    else
      :
    fi
    ;;
esac

if [ "$VERSION" != '1.0.0-rc.1' ] && [ "$#" -eq 2 ] && [ "${2:-}" = '--help' ]; then
  if has_launcher_command_usage "$1"; then
    command_usage "$1"
    exit 0
  fi
fi

case "${1:-}" in
  help|--help|--version|version) ;;
  *) check_source_form_invocation "$@" ;;
esac

runtime_error() {
  printf 'Revia runtime error: %s\n' "$1" >&2
  exit 70
}

case "$(uname -s):$(uname -m)" in
  Darwin:arm64)
    PLATFORM=darwin-arm64
    ;;
  Darwin:x86_64)
    PLATFORM=darwin-x64
    ;;
  Linux:aarch64|Linux:arm64)
    PLATFORM=linux-arm64
    ;;
  Linux:x86_64)
    PLATFORM=linux-x64
    ;;
  *)
    printf '%s\n' "Revia $VERSION has no binary for $(uname -s) $(uname -m)." >&2
    printf '%s\n' "See $ROOT/docs/compatibility.md for the current support matrix." >&2
    exit 69
    ;;
esac

if [ "$VERSION" = '1.0.0-rc.1' ] && [ "$PLATFORM" != 'darwin-arm64' ]; then
  printf '%s\n' "Revia $VERSION has a pending target: $PLATFORM. Only darwin-arm64 is measured for this RC." >&2
  printf '%s\n' "See $ROOT/docs/compatibility.md for the current support matrix." >&2
  exit 69
fi

CHECKSUMS="$ROOT/runtime/checksums.txt"
if [ ! -r "$CHECKSUMS" ]; then
  runtime_error 'Release checksums file is unavailable.'
fi
ASSET="revia-${VERSION}-${PLATFORM}.tar.gz"
EXPECTED=$(awk -v asset="$ASSET" '$2 == asset { print $1 }' "$CHECKSUMS")
EXPECTED_BINARY=$(awk -v asset="${ASSET%.tar.gz}" '$2 == asset { print $1 }' "$CHECKSUMS")
VERSION_ROWS=$(awk -v prefix="revia-${VERSION}-" 'index($2, prefix) == 1 { count++ } END { print count + 0 }' "$CHECKSUMS")
if [ "$VERSION_ROWS" -eq 0 ]; then
  runtime_error "Release checksums have no entries for $VERSION."
fi
if [ -z "$EXPECTED" ] || [ -z "$EXPECTED_BINARY" ]; then
  printf '%s\n' "Revia $VERSION has a pending target: $PLATFORM. No $PLATFORM release asset is recorded for this candidate." >&2
  printf '%s\n' "See $ROOT/docs/compatibility.md for the current support matrix." >&2
  exit 69
fi

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{ print $1 }'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{ print $1 }'
  else
    runtime_error 'Revia requires shasum or sha256sum to verify release files.'
  fi
}

INSTALL_DIR="$CACHE_ROOT/$VERSION/$PLATFORM"
EXECUTABLE="$INSTALL_DIR/revia"
if [ ! -x "$EXECUTABLE" ]; then
  command -v curl >/dev/null 2>&1 || runtime_error 'Revia requires curl to download a release asset.'
  command -v tar >/dev/null 2>&1 || runtime_error 'Revia requires tar to unpack a release asset.'
  if ! TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/revia.XXXXXX"); then
    runtime_error 'Revia could not create a temporary download directory.'
  fi
  trap 'rm -rf "$TEMP_DIR"' EXIT HUP INT TERM
  URL="$RELEASE_BASE_URL/$ASSET"
  printf '%s\n' "Downloading Revia $VERSION for $PLATFORM..." >&2
  if ! curl --fail --location --silent --show-error "$URL" --output "$TEMP_DIR/$ASSET"; then
    runtime_error 'Release download failed.'
  fi

  ACTUAL=$(sha256_file "$TEMP_DIR/$ASSET")
  if [ "$ACTUAL" != "$EXPECTED" ]; then
    runtime_error "Checksum mismatch for $ASSET."
  fi

  if ! mkdir -p "$INSTALL_DIR"; then
    runtime_error 'Revia could not create its cache directory.'
  fi
  if ! tar -xzf "$TEMP_DIR/$ASSET" -C "$TEMP_DIR"; then
    runtime_error "Release archive could not be unpacked: $ASSET."
  fi
  if [ ! -f "$TEMP_DIR/revia" ] || ! chmod 755 "$TEMP_DIR/revia"; then
    runtime_error 'Release archive did not contain an executable Revia binary.'
  fi
  if [ "$(sha256_file "$TEMP_DIR/revia")" != "$EXPECTED_BINARY" ]; then
    runtime_error "Executable checksum mismatch for ${ASSET%.tar.gz}."
  fi
  if ! mv "$TEMP_DIR/revia" "$EXECUTABLE"; then
    runtime_error 'Verified Revia executable could not be installed.'
  fi
  trap - EXIT HUP INT TERM
  rm -rf "$TEMP_DIR"
fi

if [ "$(sha256_file "$EXECUTABLE")" != "$EXPECTED_BINARY" ]; then
  runtime_error "Cached executable checksum mismatch for ${ASSET%.tar.gz}."
fi

exec "$EXECUTABLE" "$@"
